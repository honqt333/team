includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app/

    parallel:
        maximumNumberOfProcesses: 1

    # Level 5: catches undefined methods, wrong argument types, missing
    # return types, etc. Higher levels (6-9) find more bugs but require
    # extensive baseline annotations. We start at 5 — the cost/benefit
    # sweet spot for a Laravel project at our size.
    level: 5

    # Domain modelling: ignore generic Eloquent magic for now. We can
    # tighten this later with @phpstan-ignore-line + actual generic
    # annotations on the models. Without this, every ->where() call
    # would generate a "too general" warning. The phpstan-baseline.neon
    # handles the rest.
    excludePaths:
        - app/Console/Kernel.php (?)
        - app/Exceptions/Handler.php (?)
        - app/Http/Middleware/VerifyCsrfToken.php (?)
        - app/Http/Middleware/EncryptCookies.php (?)
        - app/Providers/*
        - database/migrations/*
        - database/seeders/*
        - database/factories/*
        - bootstrap/cache/*

    # Bootstrap files for Larastan — it needs to know about the Laravel
    # container and our aliases.
    bootstrapFiles:
        - bootstrap/app.php

    treatPhpDocTypesAsCertain: false

    # ─────────────────────────────────────────────────────────────────────
    # Generic Eloquent Model suppression
    # ─────────────────────────────────────────────────────────────────────
    #
    # WHY THIS EXISTS
    #
    # Every relation in app/Models/ is declared as a bare `BelongsTo` /
    # `HasMany` instead of the generic `BelongsTo<Target, $this>` form.
    # When PHPStan resolves a relation through such a declaration it
    # falls back to the base `Illuminate\Database\Eloquent\Model` type,
    # which has no knowledge of the concrete model's columns or casts.
    # That produces three families of false positives:
    #
    #   1. "Access to an undefined property Model::$foo" for every
    #      column of the related model (250 of the 463 errors).
    #   2. "Cannot call method X() on string" for date-cast columns
    #      (26 of the 463) — the base Model type has no $casts, so a
    #      `datetime` column is still seen as a raw string.
    #   3. "Parameter #N expects App\Models\Tenant, Model given"
    #      (26 of the 463) — the *declared* type of the parameter is
    #      concrete, but the *argument* type was widened to Model.
    #
    # We verified category 2 empirically rather than assuming it:
    #   php artisan tinker --execute='$m = new AppointmentMessageDelivery();
    #     $m->queued_at = "2026-01-01 10:00:00";
    #     echo get_class($m->queued_at);'
    #   => Illuminate\Support\Carbon
    # so `?->toIso8601String()` is safe at runtime.
    #
    # WHY WE SUPPRESS IT HERE AND NOT IN THE BASELINE
    #
    # These three families are ONE root cause, not 300 independent
    # defects. Putting them in phpstan-baseline.neon would freeze the
    # symptom (one entry per file/line) and make any future code that
    # introduces the same pattern look "already approved".
    # A single scoped ignore in phpstan.neon documents the root cause
    # once, and keeps the baseline free for genuine per-file issues.
    #
    # This is deliberately NARROW: it only matches the generic base
    # Model type. A concrete model type (App\Models\Tenant::$foo) is
    # still reported and still tracked in the baseline.
    #
    # HOW TO REMOVE IT
    #
    # Add generic annotations to the relations (BelongsTo<Tenant, $this>
    # etc.), then delete the two entries below. We attempted this for
    # User::tenant() plus 7 Tenant relations and the error count went
    # UP (470 => 484) because the added precision exposed new
    # mismatches elsewhere — the annotations have to be applied
    # consistently across the whole model layer to pay off.
    #
    # See audit_reports/khidmh-2026-10-25/PROJECT_AUDIT_VERIFICATION.md
    # (finding V-09) for the full evidence.
    ignoreErrors:
        -
            message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model::\$#'
            identifier: property.notFound
            path: app/*
        -
            message: '#^Call to an undefined method Illuminate\\Database\\Eloquent\\Model::#'
            identifier: method.notFound
            path: app/*
        -
            message: '#^Cannot call method [a-zA-Z_]+\(\) on string\.$#'
            identifier: method.nonObject
            path: app/*
        -
            message: '#^Parameter \#\d+ \$[a-zA-Z_]+ of method .+ expects .+, Illuminate\\Database\\Eloquent\\Model(\|null)? given\.$#'
            identifier: argument.type
            path: app/*
        -
            message: '#^Parameter \#\d+ \$[a-zA-Z_]+ of method Illuminate\\Database\\Eloquent\\Collection<int,Illuminate\\Database\\Eloquent\\Model>::[a-zA-Z_]+\(\) contains unresolvable type\.$#'
            identifier: argument.unresolvableType
            path: app/*

